{
  "$schema": "https://tr.designtokens.org/format/",
  "meta": {
    "brand": "Reharm Daily",
    "version": "1.0.0",
    "direction": "The Daily Sheet",
    "aesthetic": "Reharm Lab Ink & Parchment Broadsheet framing per-game cartridge skins"
  },
  "themes": {
    "light": {
      "surface": {
        "canvas": "#F6E9C9",
        "surface": "#FBF3DF",
        "elevated": "#EFE2C1",
        "well": "#EAD7AA",
        "hover": "#E5CFA0",
        "backdrop": "rgba(30, 42, 120, 0.42)"
      },
      "border": {
        "ink": "#1E2A78",
        "subtle": "#C9B996",
        "strong": "#877B62",
        "paperRule": "rgba(30, 42, 120, 0.16)",
        "cardLip": "rgba(30, 42, 120, 0.14)"
      },
      "text": {
        "primary": "#1E2A78",
        "secondary": "#2F3C8A",
        "muted": "#45508C"
      },
      "accent": {
        "primary": "#1E2A78",
        "primaryHover": "#16205E",
        "primarySoft": "rgba(30, 42, 120, 0.10)",
        "primarySolidBg": "#1E2A78",
        "primarySolidInk": "#FBF3DF",
        "pen": "#A52213",
        "penBg": "rgba(179, 40, 24, 0.10)",
        "penBorder": "rgba(179, 40, 24, 0.42)",
        "brass": "#7A4B06",
        "brassBg": "rgba(227, 178, 60, 0.22)",
        "brassBorder": "rgba(122, 75, 6, 0.38)"
      },
      "wash": {
        "blue": "#5B85C2",
        "mustard": "#E3B23C",
        "brick": "#B9532F",
        "sage": "#7E9C6B",
        "blend": "multiply"
      },
      "status": {
        "done": {
          "label": "Done",
          "symbol": "check-stamp",
          "fg": "#2D5629",
          "bg": "rgba(126, 156, 107, 0.20)",
          "border": "rgba(45, 86, 41, 0.42)"
        },
        "progress": {
          "label": "In Progress",
          "symbol": "half-circle",
          "fg": "#7A4404",
          "bg": "rgba(227, 178, 60, 0.24)",
          "border": "rgba(122, 68, 4, 0.42)"
        },
        "new": {
          "label": "Today's Puzzle",
          "symbol": "dot",
          "fg": "#1E2A78",
          "bg": "rgba(91, 133, 194, 0.16)",
          "border": "rgba(30, 42, 120, 0.36)"
        },
        "soon": {
          "label": "Coming Soon",
          "symbol": "blueprint",
          "fg": "#444E82",
          "bg": "rgba(30, 42, 120, 0.08)",
          "border": "rgba(68, 78, 130, 0.32)"
        },
        "mutedOk": {
          "label": "Muted-Friendly",
          "symbol": "eye",
          "fg": "#155852",
          "bg": "rgba(21, 88, 82, 0.10)"
        },
        "audioReq": {
          "label": "Audio Recommended",
          "symbol": "headphones",
          "fg": "#8C3316",
          "bg": "rgba(185, 83, 47, 0.13)"
        },
        "warn": {
          "label": "Notice",
          "symbol": "shield-alert",
          "fg": "#7A3E04",
          "bg": "#F5E0A8",
          "border": "#B87918"
        }
      },
      "focus": {
        "ring": "#1E2A78",
        "gap": "#FBF3DF"
      }
    },
    "dark": {
      "surface": {
        "canvas": "#1C1916",
        "surface": "#25211D",
        "elevated": "#312B25",
        "well": "#151210",
        "hover": "#3B342D",
        "backdrop": "rgba(12, 10, 8, 0.78)"
      },
      "border": {
        "ink": "#8C7D6B",
        "subtle": "#3B342C",
        "strong": "#877968",
        "paperRule": "rgba(232, 220, 196, 0.14)",
        "cardLip": "rgba(0, 0, 0, 0.42)"
      },
      "text": {
        "primary": "#E8DCC4",
        "secondary": "#C7B99E",
        "muted": "#A49781"
      },
      "accent": {
        "primary": "#DFB15B",
        "primaryHover": "#E9C174",
        "primarySoft": "rgba(223, 177, 91, 0.14)",
        "primarySolidBg": "#DFB15B",
        "primarySolidInk": "#181410",
        "pen": "#F58979",
        "penBg": "rgba(224, 96, 79, 0.14)",
        "penBorder": "rgba(245, 137, 121, 0.45)",
        "brass": "#DFB15B",
        "brassBg": "rgba(210, 162, 78, 0.16)",
        "brassBorder": "rgba(223, 177, 91, 0.42)"
      },
      "wash": {
        "blue": "#7F9AC0",
        "mustard": "#D2A24E",
        "brick": "#CF7040",
        "sage": "#8E9A62",
        "blend": "screen"
      },
      "status": {
        "done": {
          "label": "Done",
          "symbol": "check-stamp",
          "fg": "#A8C980",
          "bg": "rgba(142, 154, 98, 0.18)",
          "border": "rgba(168, 201, 128, 0.45)"
        },
        "progress": {
          "label": "In Progress",
          "symbol": "half-circle",
          "fg": "#E8BC66",
          "bg": "rgba(210, 162, 78, 0.18)",
          "border": "rgba(232, 188, 102, 0.45)"
        },
        "new": {
          "label": "Today's Puzzle",
          "symbol": "dot",
          "fg": "#99B9E6",
          "bg": "rgba(127, 154, 192, 0.18)",
          "border": "rgba(153, 185, 230, 0.45)"
        },
        "soon": {
          "label": "Coming Soon",
          "symbol": "blueprint",
          "fg": "#B5A892",
          "bg": "rgba(232, 220, 196, 0.08)",
          "border": "rgba(181, 168, 146, 0.30)"
        },
        "mutedOk": {
          "label": "Muted-Friendly",
          "symbol": "eye",
          "fg": "#7DD0C5",
          "bg": "rgba(125, 208, 197, 0.14)"
        },
        "audioReq": {
          "label": "Audio Recommended",
          "symbol": "headphones",
          "fg": "#F29478",
          "bg": "rgba(207, 112, 64, 0.16)"
        },
        "warn": {
          "label": "Notice",
          "symbol": "shield-alert",
          "fg": "#F2C97D",
          "bg": "#362A19",
          "border": "#C99438"
        }
      },
      "focus": {
        "ring": "#DFB15B",
        "gap": "#25211D"
      }
    }
  },
  "typography": {
    "fonts": {
      "display": "'Kalam', cursive",
      "sans": "'Plus Jakarta Sans', system-ui, -apple-system, sans-serif",
      "mono": "'JetBrains Mono', ui-monospace, SFMono-Regular, monospace"
    },
    "scale": {
      "xs": { "size": "0.6875rem", "px": 11, "lineHeight": 1.35 },
      "sm": { "size": "0.75rem", "px": 12, "lineHeight": 1.4 },
      "base": { "size": "0.875rem", "px": 14, "lineHeight": 1.45 },
      "md": { "size": "1rem", "px": 16, "lineHeight": 1.4 },
      "lg": { "size": "1.125rem", "px": 18, "lineHeight": 1.3 },
      "xl": { "size": "1.375rem", "px": 22, "lineHeight": 1.2 },
      "displayMd": { "size": "1.75rem", "px": 28, "lineHeight": 1.15 },
      "displayLg": { "size": "2.25rem", "px": 36, "lineHeight": 1.08 },
      "displayXl": { "size": "3rem", "px": 48, "lineHeight": 1.02 }
    },
    "weights": {
      "regular": 400,
      "medium": 500,
      "semibold": 600,
      "bold": 700
    }
  },
  "spacing": {
    "1": "4px",
    "2": "8px",
    "3": "12px",
    "4": "16px",
    "5": "20px",
    "6": "24px",
    "8": "32px",
    "10": "40px",
    "12": "48px",
    "16": "64px",
    "touchMin": "44px"
  },
  "radii": {
    "xs": "4px",
    "sm": "6px",
    "md": "10px",
    "lg": "14px",
    "xl": "20px",
    "pill": "9999px"
  },
  "zIndex": {
    "base": 0,
    "card": 10,
    "stamp": 15,
    "header": 30,
    "backdrop": 40,
    "sheet": 50,
    "modal": 60,
    "launch": 70,
    "toast": 80
  },
  "breakpoints": {
    "mobile": "390px",
    "tablet": "768px",
    "desktop": "1280px"
  },
  "motion": {
    "durations": {
      "instant": "80ms",
      "fast": "140ms",
      "normal": "240ms",
      "stamp": "320ms",
      "smooth": "360ms",
      "ceremony": "850ms",
      "celebrate": "1100ms"
    },
    "easings": {
      "snap": "cubic-bezier(0.2, 0.9, 0.3, 1)",
      "spring": "cubic-bezier(0.34, 1.45, 0.64, 1)",
      "stamp": "cubic-bezier(0.22, 1.28, 0.36, 1)",
      "out": "cubic-bezier(0.16, 1, 0.3, 1)",
      "linear": "linear"
    }
  }
}
