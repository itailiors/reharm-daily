  "typography": {
    "fonts": {
      "display": "'Space Grotesk', system-ui, -apple-system, sans-serif",
      "sans": "'Plus Jakarta Sans', system-ui, -apple-system, sans-serif",
      "mono": "'JetBrains Mono', ui-monospace, SFMono-Regular, monospace"
    },
    "scale": {
      "xs": { "size": "0.6875rem", "px": 11, "lineHeight": 1.35 },
      "sm": { "size": "0.75rem", "px": 12, "lineHeight": 1.4 },
      "base": { "size": "0.875rem", "px": 14, "lineHeight": 1.45 },
      "md": { "size": "1rem", "px": 16, "lineHeight": 1.4 },
      "lg": { "size": "1.125rem", "px": 18, "lineHeight": 1.3 },
      "xl": { "size": "1.375rem", "px": 22, "lineHeight": 1.2 },
      "displayMd": { "size": "1.75rem", "px": 28, "lineHeight": 1.15 },
      "displayLg": { "size": "2.25rem", "px": 36, "lineHeight": 1.05 },
      "displayXl": { "size": "3.5rem", "px": 56, "lineHeight": 1.0 }
    },
    "weights": {
      "regular": 400,
      "medium": 500,
      "semibold": 600,
      "bold": 700
    }
  },
  "spacing": {
    "1": "4px",
    "2": "8px",
    "3": "12px",
    "4": "16px",
    "5": "20px",
    "6": "24px",
    "8": "32px",
    "10": "40px",
    "12": "48px",
    "16": "64px",
    "touchMin": "44px"
  },
  "radii": {
    "xs": "4px",
    "sm": "6px",
    "md": "10px",
    "lg": "14px",
    "xl": "20px",
    "pill": "9999px"
  },
  "shadows": {
    "keycapDark": "inset 0 1px 0 rgba(255, 255, 255, 0.06), 0 2px 0 rgba(0, 0, 0, 0.45)",
    "keycapLight": "inset 0 1px 0 rgba(255, 255, 255, 0.85), 0 2px 0 rgba(24, 25, 29, 0.14)",
    "keycapActive": "inset 0 2px 4px rgba(0, 0, 0, 0.25)",
    "wellInsetDark": "inset 0 2px 6px rgba(0, 0, 0, 0.55)",
    "wellInsetLight": "inset 0 2px 5px rgba(24, 25, 29, 0.12)",
    "elevationPanel": "0 16px 40px rgba(0, 0, 0, 0.45)",
    "glowAmber": "0 0 18px rgba(232, 168, 73, 0.26)",
    "glowBrass": "0 0 14px rgba(216, 173, 102, 0.20)"
  },
  "zIndex": {
    "base": 0,
    "timeline": 10,
    "playhead": 15,
    "drawer": 20,
    "header": 30,
    "backdrop": 40,
    "modal": 50,
    "gate": 60,
    "toast": 80
  },
  "breakpoints": {
    "mobile": "390px",
    "tablet": "768px",
    "desktop": "1280px"
  },
  "motion": {
    "durations": {
      "instant": "80ms",
      "fast": "140ms",
      "normal": "240ms",
      "smooth": "360ms",
      "ceremony": "900ms",
      "pulseBeat": "1250ms"
    },
    "easings": {
      "hardwareSnap": "cubic-bezier(0.2, 0.9, 0.3, 1)",
      "springBounce": "cubic-bezier(0.34, 1.45, 0.64, 1)",
      "smoothOut": "cubic-bezier(0.16, 1, 0.3, 1)",
      "linear": "linear"
    }
  }
}
